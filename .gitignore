# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (none are needed today; ignore every variant so a key can never be committed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (screenshots are tracked under docs/)
/.superpowers/

# intermediate screenshot runs (regenerate with npm run shots); docs/screenshots/final is tracked
/docs/screenshots/phase-*/
/docs/screenshots/latest/

# local-only 4K originals and superseded delivery files (Cloudflare Pages rejects files over 25 MiB)
/media-masters/

# raw AI media and the 4K masters (about 1.7 GB): kept on disk for the media scripts, never committed
/assets-raw/

assets-raw/
media-masters/
docs/screenshots/
node_modules/
.next/
out/
.env*
!.env*.example
public/media/*.v1.*
